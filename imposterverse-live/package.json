{
  "name": "imposterverse-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "IMPOSTERVERSE LIVE — your face, your character, your secret. A live-face multiplayer social deduction game.",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/setup.mjs --models && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "postinstall": "node scripts/setup.mjs",
    "fetch-models": "node scripts/setup.mjs --models",
    "test:sim": "tsx scripts/sim.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
